# --- Database -----------------------------------------------------------
# Neon / Supabase / local Postgres. Free tier is fine for the MVP.
DATABASE_URL=postgresql://user:password@host/pantry?sslmode=require

# --- Auth ---------------------------------------------------------------
# Signs the session cookie. Generate with:  openssl rand -hex 32
SESSION_SECRET=

# --- Google / Gmail OAuth ----------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application). Enable the Gmail API on the project.
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- OpenAI -------------------------------------------------------------
OPENAI_API_KEY=
# Vision model for meal photos and bulk pantry scans.
OPENAI_VISION_MODEL=gpt-4o
# Cheaper text model for receipt parsing and meal planning.
OPENAI_TEXT_MODEL=gpt-4o-mini

# --- Unsplash (optional) -------------------------------------------------
# Free stock photos tried before paying for an AI-generated dish render — see
# src/lib/ai/stock-photo.ts. Get a key at unsplash.com/developers (free tier).
# Leave blank to skip straight to AI generation for every dish.
UNSPLASH_ACCESS_KEY=

# --- App ----------------------------------------------------------------
APP_URL=http://localhost:3000
# Shared secret for /api/cron/sync-receipts. Vercel Cron sends this
# automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
# Custom URL scheme the Expo app registers (app.json's "scheme"). The OAuth
# callback redirects here with a bearer token for platform=mobile flows.
# Optional — defaults to "pantry".
MOBILE_APP_SCHEME=pantry
